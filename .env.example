# Octupie environment variables. Copy to .env.local and fill in what you need.
# With MOCK_MODE=true every external service reads from fixtures/ and returns canned
# AI output, so nothing below MOCK_MODE is required for milestones 0–5.

# true = use fixtures and canned AI output; false = call real services (needs the keys below)
MOCK_MODE=true

# --- Supabase (Postgres, Auth, Storage) ---
# Project URL, e.g. https://xyz.supabase.co (or http://127.0.0.1:54321 for local)
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key; safe in the browser, RLS protects the data
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key; server only, bypasses RLS. Never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# --- Inngest (background jobs and schedules) ---
# Key for sending events to Inngest
INNGEST_EVENT_KEY=
# Key Inngest uses to sign requests to /api/inngest
INNGEST_SIGNING_KEY=

# --- Instagram data ---
INSTAGRAM_PROVIDER=mock            # mock | apify | meta
# Apify API token (when INSTAGRAM_PROVIDER=apify)
APIFY_TOKEN=
# Apify actor that returns an account's reels
APIFY_REELS_ACTOR_ID=
# Apify actor that returns profile details
APIFY_PROFILE_ACTOR_ID=
# Meta app credentials (when INSTAGRAM_PROVIDER=meta)
META_APP_ID=
META_APP_SECRET=
META_IG_USER_ID=                   # the app's own IG business account used for business_discovery calls
# Long-lived access token for the account above
META_ACCESS_TOKEN=

# --- AI ---
# Anthropic API key for breakdowns, voice profiles and scripts
ANTHROPIC_API_KEY=
# Model for breakdowns and scripts
CLAUDE_MODEL_SMART=claude-sonnet-5-5
# Model for quick classification and chat chips
CLAUDE_MODEL_FAST=claude-haiku-5-5
# Google Gemini API key for video understanding
GEMINI_API_KEY=
# Gemini model used to watch reels
GEMINI_VIDEO_MODEL=gemini-3.5-flash
# Speech-to-text fallback provider
STT_PROVIDER=openai                # openai | deepgram
# Used when STT_PROVIDER=openai
OPENAI_API_KEY=
# Used when STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=

# --- Billing (Paddle) ---
# Paddle API key (server only)
PADDLE_API_KEY=
# Secret for verifying Paddle webhooks
PADDLE_WEBHOOK_SECRET=
# Price IDs for each paid plan
PADDLE_PRICE_CREATOR_MONTHLY=
PADDLE_PRICE_PRO_MONTHLY=

# --- Email ---
# Resend API key for the weekly digest
RESEND_API_KEY=

# --- Product tuning ---
# A reel is an outlier when views ≥ this multiple of the creator's usual views
OUTLIER_MIN_MULTIPLE=3
